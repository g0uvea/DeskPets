<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Dimensões personalizadas dos Sliders para FluentTheme -->
        <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
        <CornerRadius x:Key="SliderTrackCornerRadius">4</CornerRadius>
        <x:Double x:Key="SliderThumbWidth">22</x:Double>
        <x:Double x:Key="SliderThumbHeight">22</x:Double>

        <!-- Brushes do Slider (Roxo Azulado / Dark Violet) -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#352D46" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3E3452" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#44395A" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#8B6CCF" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#9D7CE0" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#BFA5FF" />

        <!-- Brushes do Thumb do Slider (substitui o verde padrão) -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#8B6CCF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#9D7CE0" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#BFA5FF" />
        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#EADBFF" />

        <!-- Brushes do ToggleSwitch -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#8B6CCF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#9D7CE0" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#BFA5FF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#352D46" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#403654" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#483D5E" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#594C73" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#7E6C99" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#C4B5FD" />
    </Styles.Resources>

    <!-- Global Window & Typography -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Ubuntu, Cantarell, sans-serif" />
    </Style>

    <!-- Desativação de animações na interface quando configurado -->
    <Style Selector="Window.no-animations Button.traffic-button /template/ Border#PART_TrafficCircle">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="Window.no-animations Button.tab-pill /template/ Border#PART_TabBorder">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="Window.no-animations Button.asset-card-btn /template/ Border#PART_CardBorder">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <!-- Compact MacOS Traffic Light Buttons (22x22px, CornerRadius=11) -->
    <Style Selector="Button.traffic-button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_TrafficCircle"
                        Background="{TemplateBinding Background}"
                        CornerRadius="11"
                        Width="22"
                        Height="22"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Blue Button: Adicionar Pets (#2680EB) -->
    <Style Selector="Button.traffic-blue">
        <Setter Property="Background" Value="#2680EB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.traffic-blue:pointerover /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#3B8FF5" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.traffic-blue:pressed /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#1A6ED1" />
    </Style>

    <!-- Green Button: Minimizar (#34A82A) -->
    <Style Selector="Button.traffic-green">
        <Setter Property="Background" Value="#34A82A" />
    </Style>
    <Style Selector="Button.traffic-green:pointerover /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#44C23A" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.traffic-green:pressed /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#2A8722" />
    </Style>

    <!-- Yellow Button: Maximizar / Restaurar (#DAC62A) -->
    <Style Selector="Button.traffic-yellow">
        <Setter Property="Background" Value="#DAC62A" />
    </Style>
    <Style Selector="Button.traffic-yellow:pointerover /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#E8D53B" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.traffic-yellow:pressed /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#B8A724" />
    </Style>

    <!-- Red Button: Fechar (#D21E21) -->
    <Style Selector="Button.traffic-red">
        <Setter Property="Background" Value="#D21E21" />
    </Style>
    <Style Selector="Button.traffic-red:pointerover /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#E62F32" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.traffic-red:pressed /template/ Border#PART_TrafficCircle">
        <Setter Property="Background" Value="#B3191B" />
    </Style>

    <!-- Navigation Tab Pill Buttons (Height=30, MinWidth=120, CornerRadius=15) -->
    <Style Selector="Button.tab-pill">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_TabBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="15"
                        Padding="16,0"
                        Height="30"
                        MinWidth="120">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.18" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Active Tab Pill (Clara e destacada: #4A3E63 e texto #EADBFF) -->
    <Style Selector="Button.tab-pill.tab-pill-active">
        <Setter Property="Background" Value="#4A3E63" />
        <Setter Property="Foreground" Value="#EADBFF" />
    </Style>
    <Style Selector="Button.tab-pill.tab-pill-active:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.tab-pill.tab-pill-active:pointerover /template/ Border#PART_TabBorder">
        <Setter Property="Background" Value="#564873" />
    </Style>

    <!-- Inactive Tab Pill (#251F31 e texto nítido #8F7EA9) -->
    <Style Selector="Button.tab-pill.tab-pill-inactive">
        <Setter Property="Background" Value="#251F31" />
        <Setter Property="Foreground" Value="#8F7EA9" />
    </Style>
    <Style Selector="Button.tab-pill.tab-pill-inactive:pointerover">
        <Setter Property="Foreground" Value="#EADBFF" />
    </Style>
    <Style Selector="Button.tab-pill.tab-pill-inactive:pointerover /template/ Border#PART_TabBorder">
        <Setter Property="Background" Value="#352D46" />
    </Style>

    <!-- Asset Card Button Style (148x148, rx=15) -->
    <Style Selector="Button.asset-card-btn">
        <Setter Property="Width" Value="148" />
        <Setter Property="Height" Value="148" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="#251F31" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_CardBorder"
                        Width="148"
                        Height="148"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover no Card: Apenas a borda muda de cor, fundo permanece 100% estático sem pulso -->
    <Style Selector="Button.asset-card-btn:pointerover /template/ Border#PART_CardBorder">
        <Setter Property="BorderBrush" Value="#7E6C99" />
    </Style>

    <Style Selector="Button.asset-card-btn:pressed /template/ Border#PART_CardBorder">
        <Setter Property="Background" Value="#251F31" />
        <Setter Property="BorderBrush" Value="#9E8BBF" />
    </Style>

    <!-- Card com Pet em Tela (Destaque quando o modo de duplicados estiver desativado) -->
    <Style Selector="Button.asset-card-btn.selected /template/ Border#PART_CardBorder">
        <Setter Property="BorderBrush" Value="#9D7CE0" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ContextMenu & MenuItem Styling -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="#1B1724" />
        <Setter Property="BorderBrush" Value="#352D46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="#EADBFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#352D46" />
    </Style>

    <!-- Settings Card Container -->
    <Style Selector="Border.setting-card">
        <Setter Property="Background" Value="#251F31" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Slider Custom Styling: Mais espesso (8px) e Thumb Roxo Azulado (#8B6CCF) -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#8B6CCF" />
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Track Inativo (Fundo da barra do Slider - 8px de espessura com bordas arredondadas) -->
    <Style Selector="Slider:horizontal /template/ Border#TrackBackground">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Track Ativo (Barra preenchida antes do thumb) -->
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="#8B6CCF" />
    </Style>
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton /template/ Border">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4,0,0,4" />
        <Setter Property="Background" Value="#8B6CCF" />
    </Style>

    <!-- Slider Thumb / Holder: Roxo Azulado elegante, eliminando o verde -->
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="#8B6CCF" />
        <Setter Property="BorderBrush" Value="#EADBFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="Slider:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#9D7CE0" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="2.5" />
    </Style>

    <Style Selector="Slider:pressed /template/ Thumb">
        <Setter Property="Background" Value="#BFA5FF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- Refined ToggleSwitch Theme (Roxo Azulado) -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="BorderBrush" Value="#594C73" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="BorderBrush" Value="#8B6CCF" />
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="#8B6CCF" />
        <Setter Property="BorderBrush" Value="#9D7CE0" />
    </Style>
    <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="#9D7CE0" />
        <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>

    <!-- Custom Numeric TextBox for FPS -->
    <Style Selector="TextBox.fps-input">
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="Foreground" Value="#EADBFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="26" />
    </Style>

    <Style Selector="TextBox.fps-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#403754" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#8B6CCF" />
    </Style>

    <!-- Custom Numeric TextBox for Base Dimensions (Width / Height) -->
    <Style Selector="TextBox.dim-input">
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="Foreground" Value="#EADBFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="TextBox.dim-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#403754" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#8B6CCF" />
    </Style>

    <!-- Preset Stop Button com suporte a estado Ativo e melhor contraste -->
    <Style Selector="Button.stop-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#8F7EA9" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.stop-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="#352D46" />
    </Style>
    <Style Selector="Button.stop-btn.stop-btn-active">
        <Setter Property="Foreground" Value="#EADBFF" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.stop-btn.stop-btn-active /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#EADBFF" />
        <Setter Property="Background" Value="#4A3E63" />
    </Style>

    <!-- ScrollBar Styling -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="6" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#352D46" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#594C73" />
    </Style>
</Styles>
