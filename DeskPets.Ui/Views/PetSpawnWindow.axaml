<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DeskPets.Ui.Views.PetSpawnWindow"
    Title="DeskPet"
    Width="320"
    Height="320"
    WindowDecorations="None"
    ShowInTaskbar="False"
    Background="Transparent"
    TransparencyLevelHint="Transparent,None"
    CanResize="False"
    Cursor="SizeAll"
    PointerPressed="OnPetPointerPressed"
    PointerMoved="OnPetPointerMoved"
    PointerReleased="OnPetPointerReleased">

    <!-- Janela de Pet Flutuante na Área de Trabalho (Suporte Cross-Platform: Windows, Linux e macOS) -->
    <Panel Background="Transparent">
        <Panel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sempre no Topo" Click="OnToggleTopmostClick">
                    <MenuItem.Icon>
                        <CheckBox IsChecked="{Binding $parent[Window].Topmost, Mode=OneWay}"
                                  IsHitTestVisible="False" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Chroma Key (Fundo Transparente)" Click="OnOpenChromaKeyClick">
                    <MenuItem.Icon>
                        <TextBlock Text="🪄" FontSize="13" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Fechar este Pet" Click="OnClosePetClick">
                    <MenuItem.Icon>
                        <TextBlock Text="❌" FontSize="12" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Panel.ContextMenu>

        <Image
            Name="PetImage"
            Stretch="Uniform"
            RenderOptions.BitmapInterpolationMode="HighQuality"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- Ícone Fallback caso ainda não haja imagem -->
        <TextBlock
            Name="FallbackIcon"
            Text="🐾"
            FontSize="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="False" />

        <!-- Overlay Indicador de Carregamento Estiloso (Dark Glass com Anel Giratório Violeta) -->
        <Border
            Name="LoadingIndicator"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E61B1724"
            BorderBrush="#594C73"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,10"
            BoxShadow="0 4 16 #80000000"
            IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Arc
                    Name="SpinnerArc"
                    Width="18"
                    Height="18"
                    Stroke="#A855F7"
                    StrokeThickness="2.5"
                    StrokeLineCap="Round"
                    StartAngle="0"
                    SweepAngle="270"
                    RenderTransformOrigin="50%,50%">
                    <Arc.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Arc.RenderTransform>
                </Arc>
                <TextBlock
                    Name="LoadingText"
                    Text="Carregando..."
                    Foreground="#EADBFF"
                    FontSize="12"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
