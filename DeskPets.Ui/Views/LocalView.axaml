<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeskPets.Ui.ViewModels"
    x:Class="DeskPets.Ui.Views.LocalView"
    x:Name="LocalRoot"
    x:DataType="vm:MainViewModel">

    <Grid>
        <!-- Empty State (quando ainda não há pets importados) -->
        <Border
            IsVisible="{Binding !Assets.Count}"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <!-- Símbolo de adicionar pet -->
                <Border
                    Width="60"
                    Height="60"
                    CornerRadius="30"
                    Background="#251F31"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Text="+"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#594C73"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    Text="{Binding EmptyLocalMessage}"
                    FontSize="13"
                    Foreground="#594C73"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="380"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Responsive Grid de Pets (Padding padronizado em 10px para todos os lados) -->
        <ScrollViewer
            IsVisible="{Binding Assets.Count}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Padding="10">

            <ItemsControl ItemsSource="{Binding Assets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                        <Button
                            Classes="asset-card-btn"
                            Classes.selected="{Binding IsSelected}"
                            Command="{Binding #LocalRoot.((vm:MainViewModel)DataContext).SelectAssetCommand}"
                            CommandParameter="{Binding}">

                            <!-- Menu de Contexto (Clique com o Botão Direito) -->
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Header="{Binding #LocalRoot.((vm:MainViewModel)DataContext).SpawnPetMenuText}"
                                        Command="{Binding #LocalRoot.((vm:MainViewModel)DataContext).SpawnPetCommand}"
                                        CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🚀" FontSize="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Header="{Binding #LocalRoot.((vm:MainViewModel)DataContext).RemovePetMenuText}"
                                        Command="{Binding #LocalRoot.((vm:MainViewModel)DataContext).RemovePetCommand}"
                                        CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🗑️" FontSize="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>

                            <Grid RowDefinitions="*, 20">
                                <!-- Área de Imagem/Vídeo do Pet no Card -->
                                <Panel Grid.Row="0">
                                    <!-- Imagem / Frame decodificado -->
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="Uniform"
                                        Margin="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <!-- Ícone fallback caso não haja imagem carregada ainda -->
                                    <TextBlock
                                        Text="🐾"
                                        FontSize="28"
                                        Opacity="0.25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>

                                <!-- Bottom Label Pill (138x20, rx=10, fill=#4D000000, Text #594C73) -->
                                <Border
                                    Grid.Row="1"
                                    Height="20"
                                    Margin="5,0,5,5"
                                    CornerRadius="10"
                                    Background="#4D000000">

                                    <TextBlock
                                        Text="{Binding Name}"
                                        Foreground="#594C73"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="4,0" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
