<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeskPets.Ui.ViewModels"
    x:Class="DeskPets.Ui.Views.OptionsView"
    x:DataType="vm:MainViewModel">

    <!-- Espaçamento uniforme padronizado -->
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="12">

        <StackPanel Spacing="10" HorizontalAlignment="Stretch">

            <!-- Card 1: FPS dos Pets (0 a 60 FPS, paradas em 0, 15, 24, 30 e 60, input numérico) -->
            <Border Classes="setting-card">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock
                                Text="{Binding FpsTitle}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                            <TextBlock
                                Text="{Binding FpsSubtitle}"
                                FontSize="12"
                                Foreground="#8F7EA9" />
                        </StackPanel>

                        <!-- Badge Indicador de FPS -->
                        <Border
                            Grid.Column="1"
                            Background="#352D46"
                            CornerRadius="8"
                            Padding="12,5"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Fps, StringFormat='{}{0} FPS'}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                        </Border>
                    </Grid>

                    <!-- Slider com paradas discretas (índices 0..4) -->
                    <Slider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="4"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding FpsSliderIndex}"
                        VerticalAlignment="Center"
                        Margin="4,0" />

                    <!-- Rótulos clicáveis perfeitamente alinhados com as posições 0%, 25%, 50%, 75% e 100% -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *" Margin="4,4,4,0">
                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Classes="stop-btn"
                            Classes.stop-btn-active="{Binding IsFps0Selected}"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="0"
                            Content="0" />

                        <Button
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            Classes="stop-btn"
                            Classes.stop-btn-active="{Binding IsFps15Selected}"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="15"
                            Content="15" />

                        <Button
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            Classes="stop-btn"
                            Classes.stop-btn-active="{Binding IsFps24Selected}"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="24"
                            Content="24" />

                        <Button
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            Classes="stop-btn"
                            Classes.stop-btn-active="{Binding IsFps30Selected}"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="30"
                            Content="30" />

                        <Button
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            Classes="stop-btn"
                            Classes.stop-btn-active="{Binding IsFps60Selected}"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="60"
                            Content="60" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Tamanho Base e Escala dos Pets -->
            <Border Classes="setting-card">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock
                                Text="{Binding PetScaleTitle}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                            <TextBlock
                                Text="{Binding PetScaleSubtitle}"
                                FontSize="12"
                                Foreground="#8F7EA9" />
                        </StackPanel>

                        <!-- Indicador de Porcentagem -->
                        <Border
                            Grid.Column="1"
                            Background="#352D46"
                            CornerRadius="8"
                            Padding="12,5"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding PetScale, StringFormat='{}{0}%'}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                        </Border>
                    </Grid>

                    <!-- Slider de Escala (50% a 200%) -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
                        <TextBlock
                            Grid.Column="0"
                            Text="50%"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#8F7EA9"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />

                        <Slider
                            Grid.Column="1"
                            Minimum="50"
                            Maximum="200"
                            Value="{Binding PetScale}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="200%"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#8F7EA9"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" />
                    </Grid>

                    <!-- Inputs de Dimensões Base (Largura e Altura: 200 a 1000 px, padrão 600x600) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,14,0,0">
                        <!-- Largura Base -->
                        <Border
                            Grid.Column="0"
                            Background="#251F31"
                            BorderBrush="#352D46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,6,0">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding BaseWidthTitle}"
                                    FontSize="12"
                                    Foreground="#8F7EA9"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBox
                                        Classes="dim-input"
                                        Text="{Binding PetBaseWidthText}"
                                        MaxLength="4"
                                        ToolTip.Tip="Largura base (200 - 1000 px)" />
                                    <TextBlock
                                        Text="px"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#8F7EA9"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Altura Base -->
                        <Border
                            Grid.Column="1"
                            Background="#251F31"
                            BorderBrush="#352D46"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="6,0,0,0">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding BaseHeightTitle}"
                                    FontSize="12"
                                    Foreground="#8F7EA9"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBox
                                        Classes="dim-input"
                                        Text="{Binding PetBaseHeightText}"
                                        MaxLength="4"
                                        ToolTip.Tip="Altura base (200 - 1000 px)" />
                                    <TextBlock
                                        Text="px"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="#8F7EA9"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 3: Idioma (Português / English / 日本語) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock
                            Text="{Binding LanguageTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding LanguageSubtitle}"
                            FontSize="12"
                            Foreground="#8F7EA9" />
                    </StackPanel>

                    <!-- Botões de Troca de Idioma -->
                    <Border
                        Grid.Column="1"
                        Background="#1B1724"
                        CornerRadius="16"
                        Padding="3"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button
                                Classes="tab-pill"
                                Classes.tab-pill-active="{Binding IsPortugueseSelected}"
                                Classes.tab-pill-inactive="{Binding !IsPortugueseSelected}"
                                MinWidth="80"
                                Height="28"
                                FontSize="11"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="Português"
                                Content="Português" />

                            <Button
                                Classes="tab-pill"
                                Classes.tab-pill-active="{Binding IsEnglishSelected}"
                                Classes.tab-pill-inactive="{Binding !IsEnglishSelected}"
                                MinWidth="75"
                                Height="28"
                                FontSize="11"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="English"
                                Content="English" />

                            <Button
                                Classes="tab-pill"
                                Classes.tab-pill-active="{Binding IsJapaneseSelected}"
                                Classes.tab-pill-inactive="{Binding !IsJapaneseSelected}"
                                MinWidth="75"
                                Height="28"
                                FontSize="11"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="日本語"
                                Content="日本語" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Sempre no Topo -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock
                            Text="{Binding AlwaysOnTopTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding AlwaysOnTopSubtitle}"
                            FontSize="12"
                            Foreground="#8F7EA9" />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Card 5: Animações na Interface -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock
                            Text="{Binding AnimationsTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding AnimationsSubtitle}"
                            FontSize="12"
                            Foreground="#8F7EA9" />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding EnableAnimations, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Card 6: Sumonar Pets Duplicados -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock
                            Text="{Binding AllowDuplicatePetsTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding AllowDuplicatePetsSubtitle}"
                            FontSize="12"
                            Foreground="#8F7EA9" />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding AllowDuplicatePets, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
