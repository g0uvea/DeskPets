<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeskPets.Ui.ViewModels"
    x:Class="DeskPets.Ui.Views.OptionsView"
    x:DataType="vm:MainViewModel">

    <!-- Espaçamento uniforme padronizado em exatamente 10px -->
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="10">

        <StackPanel Spacing="8" HorizontalAlignment="Stretch">

            <!-- Card 1: FPS dos Pets (0 a 60 FPS, paradas em 0, 15, 24, 30 e 60, input numérico) -->
            <Border Classes="setting-card">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                Text="{Binding FpsTitle}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                            <TextBlock
                                Text="{Binding FpsSubtitle}"
                                FontSize="12"
                                Foreground="#594C73" />
                        </StackPanel>

                        <!-- Input Numérico Manual + Badge FPS -->
                        <Border
                            Grid.Column="1"
                            Background="#352D46"
                            CornerRadius="8"
                            Padding="6,3"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox
                                    Classes="fps-input"
                                    Text="{Binding FpsInputText}"
                                    MaxLength="2"
                                    ToolTip.Tip="Digite qualquer valor de 0 a 60 FPS" />
                                <TextBlock
                                    Text="FPS"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#EADBFF"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Slider com paradas discretas (índices 0..4) -->
                    <Slider
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="4"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding FpsSliderIndex}"
                        VerticalAlignment="Center" />

                    <!-- Rótulos clicáveis para cada parada (0, 15, 24, 30, 60) -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, *, *, *, Auto" Margin="2,2,2,0">
                        <Button
                            Grid.Column="0"
                            Classes="stop-btn"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="0"
                            Content="0" />

                        <Button
                            Grid.Column="1"
                            Classes="stop-btn"
                            HorizontalAlignment="Center"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="15"
                            Content="15" />

                        <Button
                            Grid.Column="2"
                            Classes="stop-btn"
                            HorizontalAlignment="Center"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="24"
                            Content="24" />

                        <Button
                            Grid.Column="3"
                            Classes="stop-btn"
                            HorizontalAlignment="Center"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="30"
                            Content="30" />

                        <Button
                            Grid.Column="4"
                            Classes="stop-btn"
                            HorizontalAlignment="Right"
                            Command="{Binding SetFpsPresetCommand}"
                            CommandParameter="60"
                            Content="60" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Tamanho Inicial dos Pets -->
            <Border Classes="setting-card">
                <Grid RowDefinitions="Auto, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                Text="{Binding PetScaleTitle}"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                            <TextBlock
                                Text="{Binding PetScaleSubtitle}"
                                FontSize="12"
                                Foreground="#594C73" />
                        </StackPanel>

                        <!-- Indicador de Porcentagem -->
                        <Border
                            Grid.Column="1"
                            Background="#352D46"
                            CornerRadius="8"
                            Padding="12,5"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding PetScale, StringFormat='{}{0}%'}"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="#EADBFF" />
                        </Border>
                    </Grid>

                    <!-- Slider de Escala (50% a 200%) -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto">
                        <TextBlock
                            Grid.Column="0"
                            Text="50%"
                            FontSize="11"
                            Foreground="#594C73"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />

                        <Slider
                            Grid.Column="1"
                            Minimum="50"
                            Maximum="200"
                            Value="{Binding PetScale}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="200%"
                            FontSize="11"
                            Foreground="#594C73"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 3: Idioma (Português / English) -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Text="{Binding LanguageTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding LanguageSubtitle}"
                            FontSize="12"
                            Foreground="#594C73" />
                    </StackPanel>

                    <!-- Botões de Troca de Idioma -->
                    <Border
                        Grid.Column="1"
                        Background="#1B1724"
                        CornerRadius="16"
                        Padding="3"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button
                                Classes="tab-pill"
                                Classes.tab-pill-active="{Binding IsPortugueseSelected}"
                                Classes.tab-pill-inactive="{Binding !IsPortugueseSelected}"
                                MinWidth="95"
                                Height="28"
                                FontSize="11"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="Português"
                                Content="Português" />

                            <Button
                                Classes="tab-pill"
                                Classes.tab-pill-active="{Binding IsEnglishSelected}"
                                Classes.tab-pill-inactive="{Binding !IsEnglishSelected}"
                                MinWidth="95"
                                Height="28"
                                FontSize="11"
                                Command="{Binding SelectLanguageCommand}"
                                CommandParameter="English"
                                Content="English" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Sempre no Topo -->
            <Border Classes="setting-card">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Text="{Binding AlwaysOnTopTitle}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#EADBFF" />
                        <TextBlock
                            Text="{Binding AlwaysOnTopSubtitle}"
                            FontSize="12"
                            Foreground="#594C73" />
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="1"
                        IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
